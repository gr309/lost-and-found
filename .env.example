# Generate .env.local with ./scripts/setup-local.sh (never commit real secrets).
DB_HOST=localhost
DB_PORT=3307
DB_NAME=lostfound
DB_USERNAME=lostfound
DB_PASSWORD=replace-with-a-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
# Generate once with: openssl rand -base64 32
JWT_SECRET=replace-with-a-base64-secret
PORT=8080
UPLOAD_DIR=./uploads
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_ENV=dev
APP_DEBUG=false
SQL_DEBUG=false
# Optional URL override without the `jdbc:` prefix. Leave unset for the local setup.
# DB_URL=mysql://localhost:3307/lostfound?allowPublicKeyRetrieval=true&connectionTimeZone=UTC
